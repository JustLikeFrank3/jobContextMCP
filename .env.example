# ── jobContextMCP environment variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# Full reference (every variable the code reads): docs/configuration.md

# ── MCP Transport (server.py) ────────────────────────────────────────────────
# stdio           → MCP clients spawn the process (or `docker run -i`)
# sse             → Listens on http://<host>:<port>/sse  (network clients)
# streamable-http → Listens on http://<host>:<port>/mcp  (newer clients)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── Volume paths (docker-compose only) ───────────────────────────────────────
# Absolute path to your local resume workspace folder.
# Mounts to /workspace inside the container; must match "resume_folder" in config.json.
RESUME_PATH=/absolute/path/to/your/resumes

# Absolute path to your LeetCode practice folder (optional).
LEETCODE_PATH=/absolute/path/to/your/LeetCodePractice

# ── Storage backend ──────────────────────────────────────────────────────────
# USE_SQLITE=1  → reads from data/db/jobcontextmcp.db, dual-writes SQLite + JSON.
# SQLITE_ONLY=1 → additionally skips the JSON write leg (cloud/desktop default).
# Bootstrap the DB first: .venv/bin/python scripts/migrate_to_sqlite.py
USE_SQLITE=0
SQLITE_ONLY=0

# ── HTTP transport (transport/http) ──────────────────────────────────────────
# The FastAPI server: REST API + dashboard + MCP Streamable HTTP at /mcp.
# Independent of MCP_TRANSPORT above — it's a separate process.

# Bind address. Default 127.0.0.1 (localhost only).
HOST=127.0.0.1

# Bind port for the HTTP server.
PORT=8001

# If true, overrides HOST to 0.0.0.0 (LAN / Tailscale). Default false.
# DO NOT enable without setting API_KEY (or Entra auth below).
ENABLE_REMOTE=false

# Set to true only when running behind a TLS-terminating reverse proxy
# (AKS nginx-ingress). Requires ENABLE_REMOTE=true; disables the MCP SDK
# DNS-rebinding check. Both flags are required by design.
DISABLE_REBINDING_CHECK=false

# Bearer token required by all authenticated endpoints (single-tenant auth).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset AND Entra is not configured, the server runs with auth DISABLED
# and logs a warning.
API_KEY=

# Optional comma-separated CORS origins (e.g. https://chat.openwebui.local).
CORS_ORIGINS=

# Public base URL used to build Entra/Oura redirect URIs — must match the
# app registration. Only needed for hosted deployments.
# SERVER_BASE_URL=https://your-domain

# ── Entra ID (multi-tenant hosted auth — optional) ───────────────────────────
# Setting ENTRA_TENANT_ID + ENTRA_CLIENT_ID switches auth from API_KEY to
# Entra JWTs + per-user jcmcp_ personal access tokens.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# Your Azure AD Object ID. Gates owner-only features (LaTeX PDF export) and
# selects the nightly-evals partition.
# Find it: Azure portal → Microsoft Entra ID → Users → your profile → Object ID
ENTRA_OWNER_OID=

# Fernet key for encrypting secrets at rest (Oura OAuth tokens).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=

# ── LLM provider (optional — overrides config.json) ──────────────────────────
# openai | ollama | anthropic | foundry
# LLM_PROVIDER=
# Provider-agnostic API key override (openai/anthropic/foundry; ollama needs none).
# LLM_API_KEY=

# ── Evals (optional) ─────────────────────────────────────────────────────────
# Hour 0-23 (UTC) to run the nightly golden-suite eval in the server process.
# EVALS_NIGHTLY_HOUR_UTC=8
# Default push target for `python -m evals suite --push` / `evals push`.
# JOBCONTEXT_EVAL_URL=http://127.0.0.1:8000
# JOBCONTEXT_API_KEY=

# ── Integrations (optional) ──────────────────────────────────────────────────
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# GITHUB_TOKEN=          # falls back to `gh auth token`
